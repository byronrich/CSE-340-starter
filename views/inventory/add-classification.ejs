<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
</head>
<body>
  <%- include('../partials/header') %>

  <main>
    <h1>Add New Classification</h1>

    <!-- Flash Messages -->
    <%- messages() %>

    <!-- Server-side Validation Errors -->
    <% if (errors) { %>
      <ul class="notice">
        <% errors.array().forEach(error => { %>
          <li><%= error.msg %></li>
        <% }) %>
      </ul>
    <% } %>

    <p>Classification names must contain only letters — no spaces or special characters.</p>

    <form action="/inv/add-classification" method="post" class="form">

      <label for="classification_name">Classification Name</label>
      <input 
        type="text" 
        id="classification_name" 
        name="classification_name"
        required
        pattern="^[A-Za-z]+$"
        title="Letters only. No spaces or special characters."
        value="<%= typeof classification_name != 'undefined' ? classification_name : '' %>"
      >

      <button type="submit">Add Classification</button>
    </form>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
