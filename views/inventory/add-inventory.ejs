<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
</head>
<body>
  <%- include('../partials/header') %>

  <main>
    <h1>Add New Vehicle</h1>

    <!-- Flash Messages -->
    <%- messages() %>

    <!-- Server-side Validation Errors -->
    <% if (errors) { %>
      <ul class="notice">
        <% errors.array().forEach(error => { %>
          <li><%= error.msg %></li>
        <% }) %>
      </ul>
    <% } %>

    <form action="/inv/add-inventory" method="post" class="form">

      <!-- Classification Dropdown -->
      <label for="classification_id">Classification</label>
      <%- classificationList %>

      <label for="inv_make">Make</label>
      <input 
        type="text" 
        id="inv_make" 
        name="inv_make"
        required
        value="<%= typeof inv_make != 'undefined' ? inv_make : '' %>"
      >

      <label for="inv_model">Model</label>
      <input 
        type="text" 
        id="inv_model" 
        name="inv_model"
        required
        value="<%= typeof inv_model != 'undefined' ? inv_model : '' %>"
      >

      <label for="inv_year">Year (4 digits)</label>
      <input 
        type="text" 
        id="inv_year" 
        name="inv_year"
        required
        pattern="^[0-9]{4}$"
        value="<%= typeof inv_year != 'undefined' ? inv_year : '' %>"
      >

      <label for="inv_description">Description</label>
      <textarea 
        id="inv_description" 
        name="inv_description"
        required
      ><%= typeof inv_description != 'undefined' ? inv_description : '' %></textarea>

      <label for="inv_image">Image Path</label>
      <input 
        type="text" 
        id="inv_image" 
        name="inv_image"
        required
        value="<%= typeof inv_image != 'undefined' ? inv_image : '/images/vehicles/no-image.png' %>"
      >

      <label for="inv_thumbnail">Thumbnail Path</label>
      <input 
        type="text" 
        id="inv_thumbnail" 
        name="inv_thumbnail"
        required
        value="<%= typeof inv_thumbnail != 'undefined' ? inv_thumbnail : '/images/vehicles/no-image-tn.png' %>"
      >

      <label for="inv_price">Price</label>
      <input 
        type="text" 
        id="inv_price" 
        name="inv_price"
        required
        pattern="^[0-9]+(\.[0-9]{1,2})?$"
        value="<%= typeof inv_price != 'undefined' ? inv_price : '' %>"
      >

      <label for="inv_miles">Miles</label>
      <input 
        type="text" 
        id="inv_miles" 
        name="inv_miles"
        required
        pattern="^[0-9]+$"
        value="<%= typeof inv_miles != 'undefined' ? inv_miles : '' %>"
      >

      <label for="inv_color">Color</label>
      <input 
        type="text" 
        id="inv_color" 
        name="inv_color"
        required
        pattern="^[A-Za-z]+$"
        value="<%= typeof inv_color != 'undefined' ? inv_color : '' %>"
      >

      <button type="submit">Add Vehicle</button>
    </form>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
