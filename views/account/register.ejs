<h1><%= title %></h1>

<%- messages() %>

<% if (errors && typeof errors.array === "function") { %>
  <ul class="notice">
    <% errors.array().forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
<% } %>

<p>All fields are required.</p>

<form action="/account/register" method="post" class="login-form">

  <label for="account_firstname">First name</label>
  <input 
    type="text" 
    id="account_firstname" 
    name="account_firstname"
    value="<%= typeof account_firstname != 'undefined' ? account_firstname : '' %>"
    required
  >

  <label for="account_lastname">Last name</label>
  <input 
    type="text" 
    id="account_lastname" 
    name="account_lastname"
    value="<%= typeof account_lastname != 'undefined' ? account_lastname : '' %>"
    required
  >

  <label for="account_email">Email address</label>
  <input 
    type="email" 
    id="account_email" 
    name="account_email"
    value="<%= typeof account_email != 'undefined' ? account_email : '' %>"
    required
  >

  <label for="account_password">Password</label>

  <div class="password-rules">
    Password must be at least 12 characters and contain:
    <ul>
      <li>At least 1 uppercase letter</li>
      <li>At least 1 number</li>
      <li>Special characters optional</li>
    </ul>
  </div>

  <input 
    type="password" 
    id="account_password" 
    name="account_password"
    required
    minlength="12"
    pattern="^(?=.*[A-Z])(?=.*[0-9]).{12,}$"
  >

  <button type="submit">Register</button>
</form>
